RETURN 'PersonShape.closed' AS ruleId, 'Violation' AS severity, violationCount, list_slice(coalesce(samples, []), 1, $sampleSize) AS sample;

// name: PersonShape.or
// ruleId: ex:PersonShape/sh:or
MATCH (v0:`Person`)
WITH v0, v0 AS v1
WHERE NOT (((CASE WHEN v1.`email` IS NOT NULL THEN 1 ELSE 0 END) >= 1 OR (CASE WHEN v1.`phone` IS NOT NULL THEN 1 ELSE 0 END) >= 1))
RETURN 'PersonShape.or' AS ruleId, 'ex:PersonShape' AS shape, NULL AS path, 'sh:or' AS `constraint`, 'Violation' AS severity,
       {label: label(v0), key: 'id', keyValue: v0.`id`, elementId: CAST(id(v0) AS STRING)} AS focus, {label: label(v1), keyValue: v1.`id`, elementId: CAST(id(v1) AS STRING)} AS value, 'ex:PersonShape violates sh:or' AS message, list_filter([CASE WHEN NOT ((CASE WHEN v1.`email` IS NOT NULL THEN 1 ELSE 0 END) >= 1) THEN 'ex:PersonShape/sh:or[0]/ex:email/sh:minCount' END, CASE WHEN NOT ((CASE WHEN v1.`phone` IS NOT NULL THEN 1 ELSE 0 END) >= 1) THEN 'ex:PersonShape/sh:or[1]/ex:phone/sh:minCount' END], x1 -> x1 IS NOT NULL) AS details
LIMIT $limit;

// name: PersonShape.or#summary
// ruleId: ex:PersonShape/sh:or
MATCH (v0:`Person`)
WITH v0, v0 AS v1
WHERE NOT (((CASE WHEN v1.`email` IS NOT NULL THEN 1 ELSE 0 END) >= 1 OR (CASE WHEN v1.`phone` IS NOT NULL THEN 1 ELSE 0 END) >= 1))
WITH count(*) AS violationCount, collect({label: label(v0), key: 'id', keyValue: v0.`id`, elementId: CAST(id(v0) AS STRING)}) AS samples
RETURN 'PersonShape.or' AS ruleId, 'Violation' AS severity, violationCount, list_slice(coalesce(samples, []), 1, $sampleSize) AS sample;
