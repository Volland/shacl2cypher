WITH v0, v1
WHERE NOT (v1:`Company`)
WITH count(*) AS violationCount, collect({label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))})[0..$sampleSize] AS sample
