// name: PersonShape.closed
// ruleId: ex:PersonShape/sh:closed
MATCH (v0:`Person`)
CALL { WITH v0 OPTIONAL MATCH (v0)-[x1]->() WHERE id(x1) >= 0 RETURN collect(DISTINCT type(x1)) AS c2 }
WITH v0, c2
WHERE NOT ((all(x3 IN keys(v0) WHERE x3 IN ['age', 'email', 'end', 'id', 'name', 'phone', 'start', 'tags']) AND all(x4 IN c2 WHERE x4 IN ['ADDRESS', 'EMAIL', 'ID', 'PHONE', 'WORKS_FOR'])))
RETURN 'PersonShape.closed' AS ruleId, 'ex:PersonShape' AS shape, null AS path, 'sh:closed' AS `constraint`, 'Violation' AS severity,
       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, null AS value, 'ex:PersonShape violates sh:closed' AS message, [] AS details
LIMIT $limit;

