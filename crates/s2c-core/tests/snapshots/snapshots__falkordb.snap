       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, null AS value, 'ex:PersonShape violates sh:maxCount on ex:worksFor' AS message, [] AS details
LIMIT $limit;

