       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, v1 AS value, replace(replace('{$this} has a bad name {?value}', '{$this}', coalesce(toStringOrNull(v0.`id`), toString(id(v0)))), '{?value}', coalesce(toStringOrNull(v1), '')) AS message, [] AS details
LIMIT $limit;

// name: PersonShape.name.pattern#summary
// ruleId: ex:PersonShape/ex:name/sh:pattern
MATCH (v0:`Person`)
UNWIND CASE typeOf(v0.`name`) WHEN 'Null' THEN [] WHEN 'List' THEN v0.`name` ELSE [v0.`name`] END AS v1
WITH DISTINCT v0, v1
WITH v0, v1
WHERE v1 IS NOT NULL AND NOT ((typeOf(v1) IN ['String', 'Integer'] AND size(string.matchRegEx(toStringOrNull(v1), '(?i)^[A-Z]')) > 0))
WITH count(*) AS violationCount, collect({label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))})[0..$sampleSize] AS sample
RETURN 'PersonShape.name.pattern' AS ruleId, 'Violation' AS severity, violationCount, sample;

// name: PersonShape.start.lessThan
// ruleId: ex:PersonShape/ex:start/sh:lessThan
MATCH (v0:`Person`)
WITH v0
WHERE NOT (all(x1 IN CASE typeOf(v0.`start`) WHEN 'Null' THEN [] WHEN 'List' THEN v0.`start` ELSE [v0.`start`] END WHERE x1 IS NULL OR all(x2 IN CASE typeOf(v0.`end`) WHEN 'Null' THEN [] WHEN 'List' THEN v0.`end` ELSE [v0.`end`] END WHERE x2 IS NULL OR coalesce(CASE WHEN typeOf(x1) = typeOf(x2) AND typeOf(x1) IN ['Date', 'Datetime', 'Time'] THEN CASE typeOf(x1) WHEN 'Date' THEN ((CASE WHEN typeOf(x1) = 'Date' THEN x1 END).year * 10000 + (CASE WHEN typeOf(x1) = 'Date' THEN x1 END).month * 100 + (CASE WHEN typeOf(x1) = 'Date' THEN x1 END).day) WHEN 'Datetime' THEN (((CASE WHEN typeOf(x1) = 'Datetime' THEN x1 END).year * 10000 + (CASE WHEN typeOf(x1) = 'Datetime' THEN x1 END).month * 100 + (CASE WHEN typeOf(x1) = 'Datetime' THEN x1 END).day) * 1000000 + (CASE WHEN typeOf(x1) = 'Datetime' THEN x1 END).hour * 10000 + (CASE WHEN typeOf(x1) = 'Datetime' THEN x1 END).minute * 100 + (CASE WHEN typeOf(x1) = 'Datetime' THEN x1 END).second) WHEN 'Time' THEN ((CASE WHEN typeOf(x1) = 'Time' THEN x1 END).hour * 10000 + (CASE WHEN typeOf(x1) = 'Time' THEN x1 END).minute * 100 + (CASE WHEN typeOf(x1) = 'Time' THEN x1 END).second) END < CASE typeOf(x2) WHEN 'Date' THEN ((CASE WHEN typeOf(x2) = 'Date' THEN x2 END).year * 10000 + (CASE WHEN typeOf(x2) = 'Date' THEN x2 END).month * 100 + (CASE WHEN typeOf(x2) = 'Date' THEN x2 END).day) WHEN 'Datetime' THEN (((CASE WHEN typeOf(x2) = 'Datetime' THEN x2 END).year * 10000 + (CASE WHEN typeOf(x2) = 'Datetime' THEN x2 END).month * 100 + (CASE WHEN typeOf(x2) = 'Datetime' THEN x2 END).day) * 1000000 + (CASE WHEN typeOf(x2) = 'Datetime' THEN x2 END).hour * 10000 + (CASE WHEN typeOf(x2) = 'Datetime' THEN x2 END).minute * 100 + (CASE WHEN typeOf(x2) = 'Datetime' THEN x2 END).second) WHEN 'Time' THEN ((CASE WHEN typeOf(x2) = 'Time' THEN x2 END).hour * 10000 + (CASE WHEN typeOf(x2) = 'Time' THEN x2 END).minute * 100 + (CASE WHEN typeOf(x2) = 'Time' THEN x2 END).second) END ELSE x1 < x2 END, false))))
RETURN 'PersonShape.start.lessThan' AS ruleId, 'ex:PersonShape' AS shape, 'ex:start' AS path, 'sh:lessThan' AS `constraint`, 'Violation' AS severity,
       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, null AS value, 'ex:PersonShape violates sh:lessThan on ex:start' AS message, [] AS details
LIMIT $limit;

// name: PersonShape.start.lessThan#summary
