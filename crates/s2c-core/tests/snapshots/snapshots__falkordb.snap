UNWIND CASE typeOf(v0.`tags`) WHEN 'Null' THEN [] WHEN 'List' THEN v0.`tags` ELSE [v0.`tags`] END AS v1
WITH DISTINCT v0, v1
WITH v0, v1
WHERE v1 IS NOT NULL AND NOT (coalesce(v1 IN ['a', 'b'], false))
RETURN 'PersonShape.tags.in' AS ruleId, 'ex:PersonShape' AS shape, 'ex:tags' AS path, 'sh:in' AS `constraint`, 'Violation' AS severity,
       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, v1 AS value, 'ex:PersonShape violates sh:in on ex:tags' AS message, [] AS details
