       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, {label: head(labels(v1)), keyValue: v1.`id`, elementId: toString(id(v1))} AS value, 'ex:PersonShape violates sh:or' AS message, [x9 IN [CASE WHEN NOT (size(reduce(x6 = [], x5 IN CASE typeOf(v1.`email`) WHEN 'Null' THEN [] WHEN 'List' THEN v1.`email` ELSE [v1.`email`] END | CASE WHEN x5 IS NULL OR x5 IN x6 THEN x6 ELSE x6 + [x5] END)) >= 1) THEN 'ex:PersonShape/sh:or[0]/ex:email/sh:minCount' END, CASE WHEN NOT (size(reduce(x8 = [], x7 IN CASE typeOf(v1.`phone`) WHEN 'Null' THEN [] WHEN 'List' THEN v1.`phone` ELSE [v1.`phone`] END | CASE WHEN x7 IS NULL OR x7 IN x8 THEN x8 ELSE x8 + [x7] END)) >= 1) THEN 'ex:PersonShape/sh:or[1]/ex:phone/sh:minCount' END] WHERE x9 IS NOT NULL] AS details
LIMIT $limit;

