// name: PersonShape.or
// ruleId: ex:PersonShape/sh:or
MATCH (v0:`Person`)
WITH v0, v0 AS v1
WITH v0, v1
WHERE NOT ((size(reduce(x2 = [], x1 IN CASE typeOf(v1.`email`) WHEN 'Null' THEN [] WHEN 'List' THEN v1.`email` ELSE [v1.`email`] END | CASE WHEN x1 IS NULL OR x1 IN x2 THEN x2 ELSE x2 + [x1] END)) >= 1 OR size(reduce(x4 = [], x3 IN CASE typeOf(v1.`phone`) WHEN 'Null' THEN [] WHEN 'List' THEN v1.`phone` ELSE [v1.`phone`] END | CASE WHEN x3 IS NULL OR x3 IN x4 THEN x4 ELSE x4 + [x3] END)) >= 1))
