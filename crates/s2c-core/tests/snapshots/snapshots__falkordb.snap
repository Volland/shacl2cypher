// name: PersonShape.worksFor.maxCount
// ruleId: ex:PersonShape/ex:worksFor/sh:maxCount
MATCH (v0:`Person`)
CALL { WITH v0 OPTIONAL MATCH (v0)-[x2:`WORKS_FOR`]->(x1) WHERE id(x2) >= 0 RETURN count(DISTINCT x1) <= 1 AS c3 }
WITH v0, c3
WHERE NOT (c3)
