// name: PersonShape.worksFor.class
// ruleId: ex:PersonShape/ex:worksFor/sh:class
MATCH (v0:`Person`)
MATCH (v0)-[x1:`WORKS_FOR`]->(v1) WHERE id(x1) >= 0
WITH DISTINCT v0, v1
WITH v0, v1
WHERE NOT (v1:`Company`)
RETURN 'PersonShape.worksFor.class' AS ruleId, 'ex:PersonShape' AS shape, 'ex:worksFor' AS path, 'sh:class' AS `constraint`, 'Violation' AS severity,
       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, {label: head(labels(v1)), keyValue: v1.`id`, elementId: toString(id(v1))} AS value, 'ex:PersonShape violates sh:class on ex:worksFor' AS message, [] AS details
LIMIT $limit;

// name: PersonShape.worksFor.class#summary
