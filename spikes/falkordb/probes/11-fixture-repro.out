==== cardinality: compiled tags.minCount detail
MATCH (v0:`Person`)
WITH v0
WHERE NOT (size(reduce(x2 = [], x1 IN CASE typeOf(v0.`tags`) WHEN 'Null' THEN [] WHEN 'List' THEN v0.`tags` ELSE [v0.`tags`] END | CASE WHEN x1 IS NULL OR x1 IN x2 THEN x2 ELSE x2 + [x1] END)) >= 1)
RETURN 'PersonShape.tags.minCount' AS ruleId, 'ex:PersonShape' AS shape, 'ex:tags' AS path, 'sh:minCount' AS `constraint`, 'Violation' AS severity,
       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, null AS value, 'ex:PersonShape violates sh:minCount on ex:tags' AS message, [] AS details
LIMIT $limit

