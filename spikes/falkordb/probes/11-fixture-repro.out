==== ranges: compiled born rules
WHERE v1 IS NOT NULL AND NOT (coalesce(v1 > date('1900-01-01'), false))
       {label: head([l IN labels(v0) WHERE l IN ['Person']] + labels(v0)), key: 'id', keyValue: v0.`id`, elementId: toString(id(v0))} AS focus, v1 AS value, 'ex:PersonShape violates sh:minExclusive on ex:born' AS message, [] AS details

