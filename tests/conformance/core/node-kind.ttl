@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s2c: <https://w3id.org/shacl2cypher#> .

ex:PersonShape sh:targetClass ex:Person ;
    sh:property [ sh:path ex:name ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path ex:nick ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path ex:worksFor ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path ex:knows ; sh:nodeKind sh:Literal ] .
