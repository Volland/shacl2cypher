@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s2c: <https://w3id.org/shacl2cypher#> .

ex:PersonShape sh:targetClass ex:Person ;
    sh:property [ sh:path ex:age ; sh:minInclusive 0 ; sh:maxExclusive 150 ] ;
    sh:property [ sh:path ex:score ; sh:minExclusive 0.0 ; sh:maxInclusive 10 ] ;
    sh:property [ sh:path ex:born ; sh:minExclusive "1900-01-01"^^xsd:date ;
                  sh:maxInclusive "2020-12-31"^^xsd:date ] .
