@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s2c: <https://w3id.org/shacl2cypher#> .

ex:PersonShape sh:targetClass ex:Person ;
    sh:property [ sh:path ex:email ; sh:equals ex:login ] ;
    sh:property [ sh:path ex:nick ; sh:disjoint ex:name ] ;
    sh:property [ sh:path ex:start ; sh:lessThan ex:end ] ;
    sh:property [ sh:path ex:low ; sh:lessThanOrEquals ex:high ] .
