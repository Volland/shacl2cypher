@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s2c: <https://w3id.org/shacl2cypher#> .

ex:Person a rdfs:Class , sh:NodeShape ;
    sh:property [ sh:path ex:name ; sh:minCount 1 ] .

ex:EmployerShape sh:targetObjectsOf ex:worksFor ;
    sh:property [ sh:path ex:name ; sh:minCount 1 ] .

ex:EmployeeShape sh:targetSubjectsOf ex:worksFor ;
    sh:property [ sh:path ex:salary ; sh:minCount 1 ] .
