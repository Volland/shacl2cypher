@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:TextShape sh:targetClass ex:Text ;
    sh:property [ sh:path ex:g ; sh:pattern "a.c" ; sh:flags "q" ] ;
    sh:property [ sh:path ex:h ; sh:pattern "^\\p{Lu}\\p{Ll}+$" ] ;
    sh:property [ sh:path ex:i ; sh:pattern "^\\i\\c*$" ] ;
    sh:property [ sh:path ex:j ; sh:pattern "^[a-z-[aeiou]]+$" ] .
