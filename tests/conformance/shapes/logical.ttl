@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ContactShape sh:targetClass ex:Person ;
    sh:or ( [ sh:path ex:email ; sh:minCount 1 ] [ sh:path ex:phone ; sh:minCount 1 ] ) ;
    sh:xone ( [ sh:path ex:ssn ; sh:minCount 1 ] [ sh:path ex:passport ; sh:minCount 1 ] ) ;
    sh:not [ sh:path ex:banned ; sh:hasValue true ] .

ex:NameShape sh:targetClass ex:Person ;
    sh:and ( [ sh:path ex:first ; sh:minCount 1 ] [ sh:path ex:last ; sh:minCount 1 ] ) .
